<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/edit_text_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvBookingService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/barber_white"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Corte de Cabello" />

    <TextView
        android:id="@+id/tvBookingDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/barber_grey"
        android:textSize="16sp"
        tools:text="2025-11-10 a las 15:30" />

    <TextView
        android:id="@+id/tvBookingBarber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/barber_grey"
        tools:text="Barbero: Carlos" />

    <TextView
        android:id="@+id/tvBookingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@color/barber_gold"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/barber_black"
        android:textStyle="bold"
        tools:text="Pendiente" />

</LinearLayout>
